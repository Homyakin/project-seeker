<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd"
>
    <changeSet context="legacy" author="Cursor" id="anomaly-challenge-daily">
        <createTable tableName="anomaly_challenge_day">
            <column name="pgroup_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk-anomaly-challenge-day"/>
            </column>
            <column name="day_date" type="DATE">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk-anomaly-challenge-day"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="anomaly_challenge_day"
                baseColumnNames="pgroup_id"
                constraintName="fk-anomaly-challenge-day-pgroup"
                referencedTableName="pgroup"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
