<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd"
>
    <changeSet context="legacy" author="Cursor" id="add-anomaly-expedition">
        <insert tableName="event_type">
            <column name="id" value="5"/>
            <column name="name" value="Аномалия"/>
        </insert>

        <insert tableName="event">
            <column name="type_id" value="5"/>
            <column name="is_enabled" valueBoolean="true"/>
            <column name="code" value="anomaly-expedition"/>
        </insert>

        <createTable tableName="anomaly_rating">
            <column name="pgroup_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk-anomaly-rating"/>
            </column>
            <column name="rating" type="INTEGER" defaultValueNumeric="1000">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="anomaly_rating"
                baseColumnNames="pgroup_id"
                constraintName="fk-anomaly-rating-pgroup"
                referencedTableName="pgroup"
                referencedColumnNames="id"/>

        <createTable tableName="anomaly">
            <column name="launched_event_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk-anomaly"/>
            </column>
            <column name="pgroup_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_personage_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="phase" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="mode" type="TEXT"/>
            <column name="pve_template_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="opponent_pgroup_id" type="BIGINT"/>
            <column name="opponent_owner_personage_id" type="BIGINT"/>
            <column name="winner_pgroup_id" type="BIGINT"/>
            <column name="gvg_rating_at_start" type="INTEGER"/>
            <column name="search_end_date" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="anomaly"
                baseColumnNames="launched_event_id"
                constraintName="fk-anomaly-launched-event"
                referencedTableName="launched_event"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="anomaly"
                baseColumnNames="pgroup_id"
                constraintName="fk-anomaly-pgroup"
                referencedTableName="pgroup"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="anomaly"
                baseColumnNames="owner_personage_id"
                constraintName="fk-anomaly-owner-personage"
                referencedTableName="personage"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="anomaly"
                baseColumnNames="opponent_pgroup_id"
                constraintName="fk-anomaly-opponent-pgroup"
                referencedTableName="pgroup"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="anomaly"
                baseColumnNames="opponent_owner_personage_id"
                constraintName="fk-anomaly-opponent-owner-personage"
                referencedTableName="personage"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="anomaly"
                baseColumnNames="winner_pgroup_id"
                constraintName="fk-anomaly-winner-pgroup"
                referencedTableName="pgroup"
                referencedColumnNames="id"/>
        <createIndex tableName="anomaly" indexName="idx-anomaly-pgroup-phase">
            <column name="pgroup_id"/>
            <column name="phase"/>
        </createIndex>
        <createIndex tableName="anomaly" indexName="idx-anomaly-opponent-pgroup">
            <column name="opponent_pgroup_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
